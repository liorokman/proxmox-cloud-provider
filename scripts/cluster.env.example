# Settings for scripts/bootstrap-cluster.sh. Copy, edit, and run:
#   scripts/bootstrap-cluster.sh -c cluster.env up

CLUSTER_NAME=k8s1

# Proxmox storages: VM disks, and one that allows "snippets"
STORAGE=local-lvm
SNIPPET_STORAGE=local

# The LAN (the bridge the Proxmox node is on)
LAN_BRIDGE=vmbr0
LAN_CIDR_BITS=24   # must match your LAN, e.g. 22 for a /22
LAN_GW=192.168.1.1
# Three unused LAN addresses. Exclude the range from your DHCP server.
LB_MGMT_IP=192.168.1.50          # load balancer management and gRPC
LB_EXT_IP=192.168.1.51           # the load balancer's own LAN address
LB_EXT_START=192.168.1.100       # virtual IPs; the first is the API server
LB_EXT_END=192.168.1.150

# The cluster's own network. It must not overlap the LAN or other clusters.
NODE_SUBNET=192.168.50.0/24
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# A VM template with kubeadm, kubelet and containerd (see the README)
K8S_TEMPLATE_ID=9000
SSH_PUBLIC_KEY_FILE=/root/.ssh/id_ed25519.pub
WORKERS=2
# 1 (the default), or more for stacked etcd members. Use an odd number: 2 is worse than 1
# (either member down stops etcd). The ones after the first get the VM IDs and addresses
# below, which keep their place when workers are added.
#CONTROL_PLANES=1
NODE_CORES=2
NODE_MEMORY=4096
NODE_DISK_GB=20

# Pool and Proxmox user of the cloud provider (defaults shown). The token of the
# user sees the VMs in the pool only.
#POOL=k8s-k8s1
#PVE_USER=ccm-k8s1@pve
# Proxmox tags of the VMs and the container; the VMs' tags become node labels
#TAGS="k8s;k8s1"
# yes: the VMs and the container become HA resources. Needs 2 or more Proxmox
# nodes. With 3 or more nodes there are also rules that keep the load balancer away
# from the control plane, and the workers away from each other (as far as they
# fit on the nodes that remain after one node fails: such rules are strict, and
# a rule that can't be met makes the HA manager leave guests of a failed node down).
# With 3 or more control planes, one per node: that keeps etcd's majority through
# a node failure.
#HA=no

# Control plane disks on storage that is local to each Proxmox node (a fast disk): etcd syncs its
# write-ahead log on every change, and on slow or replicated storage (Ceph on hard disks, NFS)
# the API server times out. With this, each control plane is created on its own node (CP_NODES,
# default: the nodes by name), and is not an HA resource: etcd keeps the state three times, and a
# control plane that is down waits for its node. Needs CONTROL_PLANES=3 to survive a node failure.
#CP_STORAGE=fast
#CP_NODES="pve-a pve-b pve-c"

# VM IDs
LB_VMID=1100
CONTROL_PLANE_VMID=1101
WORKER_VMID_START=1102
#EXTRA_CP_VMID_START=1151        # VM IDs of the control planes after the first (default: CONTROL_PLANE_VMID + 50)
#EXTRA_CP_IP_START=53            # last octet of the second control plane (default: NODE_IP_START + 50)

# Optional: use binaries you built instead of a release download
#LBMANAGER_BIN_DIR=/root/build
#IMAGE_TAG=v0.4.0

# The load balancer container: "appliance" (a prebuilt template, built on the
# first run) or "hookscript" (stock Debian configured by scripts/installLB.sh)
#LB_MODE=appliance

# Load an image archive (docker save) into every node, for an image that isn't
# published yet. Needs the private key next to SSH_PUBLIC_KEY_FILE.
#IMAGE_ARCHIVE=/root/proxmox-cloud-provider.tar
