# Settings for scripts/bootstrap-cluster.sh. Copy, edit, and run:
#   scripts/bootstrap-cluster.sh -c cluster.env up

CLUSTER_NAME=k8s1

# Proxmox storages: VM disks, and one that allows "snippets"
STORAGE=local-lvm
SNIPPET_STORAGE=local

# The LAN (the bridge the Proxmox node is on)
LAN_BRIDGE=vmbr0
LAN_CIDR_BITS=24   # must match your LAN, e.g. 22 for a /22
LAN_GW=192.168.1.1
# Three unused LAN addresses. Exclude the range from your DHCP server.
LB_MGMT_IP=192.168.1.50          # load balancer management and gRPC
LB_EXT_IP=192.168.1.51           # the load balancer's own LAN address
LB_EXT_START=192.168.1.100       # virtual IPs; the first is the API server
LB_EXT_END=192.168.1.150

# The cluster's own network. It must not overlap the LAN or other clusters.
NODE_SUBNET=192.168.50.0/24
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# A VM template with kubeadm, kubelet and containerd (see the README)
K8S_TEMPLATE_ID=9000
SSH_PUBLIC_KEY_FILE=/root/.ssh/id_ed25519.pub
WORKERS=2
NODE_CORES=2
NODE_MEMORY=4096
NODE_DISK_GB=20

# VM IDs
LB_VMID=1100
CONTROL_PLANE_VMID=1101
WORKER_VMID_START=1102

# Optional: use binaries you built instead of a release download
#LBMANAGER_BIN_DIR=/root/build
#IMAGE_TAG=v0.2.0

# The load balancer container: "appliance" (a prebuilt template, built on the
# first run) or "hookscript" (stock Debian configured by scripts/installLB.sh)
#LB_MODE=appliance
